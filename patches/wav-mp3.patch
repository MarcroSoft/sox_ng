+
+/* The same format with the same code behind it, but writing an MP3 stream
+ * into the data chunk instead of samples.  Reading needs no such spelling,
+ * because the fmt chunk says what is in there.
+ *
+ * It has to be a handler of its own rather than one more name in the list
+ * above, because the encodings a handler writes are also what sox_ng.c
+ * consults when it decides whether the output file can simply keep the input
+ * file's encoding.  With MP3 in the wav handler's list, `sox_ng x.mp3 x.wav'
+ * would quietly hand back an MP3 in a RIFF wrapper instead of the PCM the
+ * user asked for.  Here MP3 is the only thing the handler writes, so it is
+ * what gets picked, and nothing else can stumble into it.
+ */
+LSX_FORMAT_HANDLER(wavmp3)
+{
+  static char const * const names[] = {"wavmp3", NULL};
+  static unsigned const write_encodings[] = {
+    SOX_ENCODING_MP3, 0,
+    0};
+  /* The rates MPEG-1 and MPEG-2 layer 3 have, the same list the mp3 handler
+   * gives.  Without it sox_ng would hand LAME a rate it can't encode at and
+   * let it quietly pick a neighbouring one, instead of putting a `rate'
+   * effect in the chain and saying so. */
+  static sox_rate_t const write_rates[] = {
+    8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000, 0};
+  static sox_format_handler_t const handler = {SOX_LIB_VERSION_CODE,
+    "MPEG audio in a Microsoft RIFF wrapper", names, SOX_FILE_LIT_END,
+    startread_wav, read_samples_wav, stopread_wav,
+    startwrite_wav, write_samples_wav, stopwrite_wav,
+    seek_wav, write_encodings, write_rates, sizeof(priv_t)
+  };
+  return &handler;
+}
