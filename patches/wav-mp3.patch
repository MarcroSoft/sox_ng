+/****************************************************************************/
+/* MPEG audio (WAVE_FORMAT_MPEG and WAVE_FORMAT_MPEGLAYER3) Support         */
+/****************************************************************************/
+
+/* The data chunk of these files is a plain MPEG-1 elementary stream: byte for
+ * byte what an .mp2 or .mp3 file is made of, only with a RIFF wrapper round
+ * it.  Rather than have a second copy of libmad in here, we let the "mp3"
+ * format handler decode it.
+ *
+ * That handler keeps its state in ft->priv, which is already taken by ours,
+ * so each of the four places that call into it swaps in a private area of
+ * its own and swaps ours back afterwards.  Everything else in ft is deliberately shared:
+ * the FILE *, the signal and encoding info it fills in, and ft->data_start,
+ * which startread_wav() has already pointed at the data chunk and which is
+ * where mp3-mad.c rewinds to.
+ *
+ * It reads the file for itself rather than being fed the data chunk, so
+ * ft->data_end stops it at the end of that chunk.  Without it a trailing
+ * LIST or id3 chunk that happened to start with a byte pair that looks like
+ * an MPEG sync word would be decoded as another frame of audio.
+ */
+static int startread_mpeg_wav(sox_format_t * ft, uint64_t qwDataLength)
+{
+    priv_t *     wav = (priv_t *) ft->priv;
+    sox_format_handler_t const * handler = sox_find_format("mp3", sox_false);
+    unsigned     header_channels = ft->signal.channels;
+    sox_rate_t   header_rate = ft->signal.rate;
+    int rc;
+
+    if (!handler || !handler->startread || !handler->read) {
+        lsx_fail_errno(ft, SOX_EHDR,
+            "this build has no decoder for %s audio in a WAV file",
+            wav_format_str(wav->formatTag));
+        return SOX_EOF;
+    }
+    wav->mp3_handler = handler;
+    wav->mp3_priv = lsx_calloc((size_t)1, handler->priv_size);
+
+    /* Not when the data chunk carries one of the "length unknown" markers:
+     * then the rest of the file is all we have to go on.  The limit is set
+     * here and not where the data chunk is found because startread_wav()
+     * reads past it on purpose, looking for a trailing LIST chunk. */
+    if (!wav->ignoreSize)
+        ft->data_end = wav->dataStart + qwDataLength;
+
+    /* startread_mad() works out the length by scanning the frames unless
+     * ft->signal.length says not to bother.  wav->ignoreSize is that same
+     * flag, which startread_wav() took out of ft->signal.length before
+     * overwriting it - and it is also set when the data chunk carries one of
+     * the "length unknown" markers, where scanning would be just as futile. */
+    ft->signal.length = wav->ignoreSize ? SOX_IGNORE_LENGTH : SOX_UNSPEC;
+
+    ft->priv = wav->mp3_priv;
+    rc = handler->startread(ft);
+    ft->priv = wav;
+
+    if (rc != SOX_SUCCESS) {
+        free(wav->mp3_priv);
+        wav->mp3_priv = NULL;
+        return rc;
+    }
+
+    /* The rate, the channel count and the encoding (MP1, MP2 or MP3) now come
+     * from the MPEG frames themselves, which know better than the fmt chunk
+     * does.  A file where the two disagree is malformed, so say so. */
+    if (ft->signal.channels != header_channels)
+        lsx_warn("fmt chunk says %u channel%s but the MPEG stream has %u",
+                 header_channels, header_channels == 1 ? "" : "s",
+                 ft->signal.channels);
+    if (ft->signal.rate != header_rate)
+        lsx_warn("fmt chunk says %g samples/sec but the MPEG stream has %g",
+                 header_rate, ft->signal.rate);
+
+    if (ft->signal.length && ft->signal.length != SOX_IGNORE_LENGTH)
+        wav->numSamples = ft->signal.length / ft->signal.channels;
+    else {
+        wav->numSamples = 0;
+        wav->ignoreSize = 1;
+        ft->signal.length = SOX_UNSPEC;
+    }
+
+    return SOX_SUCCESS;
+}
+
+/* The other direction, for the "wavmp3" spelling of this format: let the mp3
+ * handler encode into the data chunk.  Same swapping of ft->priv, and
+ * ft->data_start is again what keeps the borrowed handler in its own half of
+ * the file - mp3-lame.c seeks back to it to rewrite its VBR tag, and without
+ * it that write would land on top of the RIFF header.
+ *
+ * Called from startwrite_wav() once the header is on disk, so that
+ * lsx_tell() here is the first byte of the data chunk.
+ */
+static int startwrite_mpeg_wav(sox_format_t * ft)
+{
+    priv_t *     wav = (priv_t *) ft->priv;
+    sox_format_handler_t const * handler = sox_find_format("mp3", sox_false);
+    sox_comments_t comments;
+    int rc;
+
+    if (!handler || !handler->startwrite || !handler->write) {
+        lsx_fail_errno(ft, SOX_EFMT,
+                       "this build has no MP3 encoder to write `%s' with",
+                       ft->filename);
+        return SOX_EOF;
+    }
+    wav->mp3_handler = handler;
+    wav->mp3_priv = lsx_calloc((size_t)1, handler->priv_size);
+    wav->dataStart = lsx_tell(ft);
+    ft->data_start = wav->dataStart;
+
+    /* Plain .wav output drops comments - wavwritehdr() writes no LIST chunk -
+     * so they are hidden from the encoder here too.  Otherwise it would open
+     * the data chunk with an ID3v2 tag, which is the last thing the elderly
+     * software that wants a RIFF wrapper is expecting to find there. */
+    comments = ft->oob.comments;
+    ft->oob.comments = NULL;
+    ft->priv = wav->mp3_priv;
+    rc = handler->startwrite(ft);
+    ft->priv = wav;
+    ft->oob.comments = comments;
+
+    if (rc != SOX_SUCCESS) {
+        free(wav->mp3_priv);
+        wav->mp3_priv = NULL;
+        return rc;
+    }
+    return SOX_SUCCESS;
+}
